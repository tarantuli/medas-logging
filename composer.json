{
  "name": "morphp/medas-error-log",
  "description": "Medas error log",
  "keywords": [
    "backend"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "morphp/medas-core": "dev-dev",
    "morphp/medas-service-manager": "dev-dev",
    "ext-mbstring": "*",
    "phpmailer/phpmailer": "^7.0"
  },
  "require-dev": {
    "morphp/medas-config-manager": "dev-dev",
    "morphp/medas-config-options": "dev-dev",
    "morphp/medas-file-system": "dev-dev",
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "Medas\\ErrorLog\\": "src/",
      "Medas\\ErrorLogTest\\": "tests/"
    }
  }
